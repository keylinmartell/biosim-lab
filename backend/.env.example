# BioSIM Lab - Configuracion de Base de Datos
# Para PostgreSQL Local (tu base de datos creada 'biosim'):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=biosim

# O para conexion directa a Supabase (Transaction Pooler o Direct Connection):
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
