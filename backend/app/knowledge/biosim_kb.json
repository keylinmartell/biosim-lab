  "rules": [
    {
      "id": "R01",
      "if": "dsb > 0",
      "then": "MRN detecta y activa ATM",
      "evidence": "literatura",
      "source": "JACKSON09"
    },
    {
      "id": "R02",
      "if": "ATM activo",
      "then": "fosforila p53 Ser15/Ser20 -> MDM2 deja de degradarlo -> p53 se acumula",
      "evidence": "literatura",
      "source": "LEVINE09"
    },
    {
      "id": "R03",
      "if": "p53 bajo/transitorio",
      "then": "promotores de alta afinidad: p21, MDM2, GADD45 -> parada y reparacion",
      "evidence": "literatura",
      "source": "COLAB"
    },
    {
      "id": "R04",
      "if": "p53 alto y sostenido (> umbral durante > t_sostenido)",
      "then": "promotores de baja afinidad: PUMA, BAX -> apoptosis",
      "evidence": "literatura",
      "source": "COLAB"
    },
    {
      "id": "R05",
      "if": "p21 alto",
      "then": "inhibe CDK2/CDK4/6 -> Rb hipofosforilado -> E2F apagado -> no cruza punto R",
      "evidence": "literatura",
      "source": "COLAB"
    },
    {
      "id": "R06",
      "if": "mitogenos",
      "then": "ERK -> ciclina D -> CDK4/6 fosforila Rb -> E2F libre -> ciclina E -> bucle positivo (biestable)",
      "evidence": "literatura",
      "source": "COLAB"
    },
    {
      "id": "R07",
      "if": "RbP > 0.7 sostenido",
      "then": "punto R cruzado: entra a fase S aunque se retiren mitogenos",
      "evidence": "didactico",
      "source": "COLAB"
    },
    {
      "id": "R08",
      "if": "OCT4 y SOX2 altos",
      "then": "autoactivacion de OCT4, SOX2 y NANOG",
      "evidence": "literatura",
      "source": "BOYER05"
    },
    {
      "id": "R09",
      "if": "acido retinoico o LIF/FGF2 bajo",
      "then": "baja OCT4/NANOG; si SOX2 se mantiene -> PAX6 (ectodermo)",
      "evidence": "literatura",
      "source": "ALB_CGE"
    },
    {
      "id": "R10",
      "if": "BMP4 + WNT medio, FGF bajo",
      "then": "BRACHYURY (mesodermo)",
      "evidence": "literatura",
      "source": "ALB_CGE"
    },
    {
      "id": "R11",
      "if": "ActivinaA/WNT alto",
      "then": "SOX17 (endodermo)",
      "evidence": "literatura",
      "source": "ALB_CGE"
    },
    {
      "id": "R12",
      "if": "OCT4 muy bajo + BMP4",
      "then": "CDX2 (trofectodermo)",
      "evidence": "literatura",
      "source": "ALB_CGE"
    },
    {
      "id": "R13",
      "if": "lesion oxidativa",
      "then": "BER con probabilidad = eficiencia_reparacion por intento; puede saturarse",
      "evidence": "didactico",
      "source": "COLAB"
    },
    {
      "id": "R14",
      "if": "TP53_funcional = false",
      "then": "no hay parada por dano; celula danada cruza R; tasa de mutacion aumenta",
      "evidence": "literatura",
      "source": "COLAB"
    },
    {
      "id": "R15",
      "if": "transcripcion",
      "then": "ARN 5'->3' sobre hebra molde 3'->5'; U por T; no reemplazo ciego T->U",
      "evidence": "literatura",
      "source": "ALB_DNA_RNA"
    },
    {
      "id": "R16",
      "if": "traduccion",
      "then": "inicio AUG; codon STOP no anade aminoacido",
      "evidence": "literatura",
      "source": "ALB_BGM"
    },
    {
      "id": "R17",
      "if": "PSC con dano",
      "then": "las celulas pluripotentes son muy sensibles: umbral de apoptosis menor que en somaticas",
      "evidence": "literatura",
      "source": "ALB7"
    },
    {
      "id": "R18",
      "if": "ficha de gen",
      "then": "promotor, region transcrita, exones/intrones y CDS son entidades distintas; no toda secuencia se transcribe",
      "evidence": "literatura",
      "source": "ALB_DNA_RNA"
    },
    {
      "id": "R19",
      "if": "transcripcion",
      "then": "se identifica primero la hebra molde segun la orientacion del gen (+/-); ARN 5'->3' complementario a la molde",
      "evidence": "literatura",
      "source": "ALB_DNA_RNA"
    },
    {
      "id": "R20",
      "if": "secuencia con simbolos no ACGT o incompleta",
      "then": "se marca invalida/no resuelta; nunca se corrige en silencio",
      "evidence": "didactico",
      "source": "COLAB"
    },
    {
      "id": "R21",
      "if": "pre-ARNm",
      "then": "se anade caperuza 5' (presente/ausente, sin quimica)",
      "evidence": "literatura",
      "source": "ALB_DNA_RNA"
    },
    {
      "id": "R22",
      "if": "intron con senales GU...AG",
      "then": "splicing: se retira el intron y se unen exones; se guardan pre-ARNm, intrones retirados y ARNm maduro (patron fijo)",
      "evidence": "literatura",
      "source": "ALB_DNA_RNA"
    },
    {
      "id": "R23",
      "if": "senal AAUAAA en 3'",
      "then": "corte y poliadenilacion (cola poli-A como propiedad)",
      "evidence": "literatura",
      "source": "ALB_DNA_RNA"
    },
    {
      "id": "R24",
      "if": "ARNm maduro",
      "then": "traduccion desde el primer AUG en marco hasta el primer STOP; detecta longitud no multiplo de 3 y ausencia de STOP",
      "evidence": "literatura",
      "source": "ALB_BGM"
    },
    {
      "id": "R25",
      "if": "variante sinonima",
      "then": "cambia codon, mismo aminoacido; no se declara neutra automaticamente",
      "evidence": "literatura",
      "source": "COLAB"
    },
    {
      "id": "R26",
      "if": "variante missense",
      "then": "se registra posicion y aa ref/var; sin declarar patogenicidad",
      "evidence": "literatura",
      "source": "COLAB"
    },
    {
      "id": "R27",
      "if": "variante nonsense",
      "then": "proteina truncada potencial; NMD no simulado",
      "evidence": "literatura",
      "source": "COLAB"
    },
    {
      "id": "R28",
      "if": "p53 activo y elemento de respuesta en promotor (CDKN1A)",
      "then": "p53 tetramero se une por el surco mayor y activa la transcripcion (alta afinidad)",
      "evidence": "literatura",
      "source": "LEVINE09"
    },
    {
      "id": "R29",
      "if": "gen silenciado / expresion < 0.1",
      "then": "cromatina compacta en nucleosomas (147 pb, 1,65 vueltas); sin transcripcion",
      "evidence": "literatura",
      "source": "ALB_CGE"
    },
    {
      "id": "R30",
      "if": "DSB dentro del locus",
      "then": "la ARN polimerasa no atraviesa la rotura; transcripcion del locus bloqueada hasta reparar",
      "evidence": "literatura",
      "source": "JACKSON09"
    }
  ],
